</div>

<div class="modal fade" id="editPartModal" tabindex="-1" aria-labelledby="editPartModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="editPartModalLabel"><i class="fa-solid fa-pen-to-square"></i> Chỉnh sửa Linh kiện</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="formEditPart">
                    <input type="hidden" id="editMaHang"> 

                    <label class="form-label mt-2">Tên linh kiện</label>
                    <input class="form-control" id="editTenHang">

                    <label class="form-label mt-2">Nhóm linh kiện</label>
                    <select class="form-select" id="editLoaiHang">
                        <option value="Ắc quy">Ắc quy</option>
                        <option value="Động cơ">Động cơ</option>
                        <option value="Phanh - thắng">Phanh - thắng</option>
                        <option value="Khung sườn">Khung sườn</option>
                        <option value="Khác">Khác</option>
                    </select>

                    <label class="form-label mt-2">Giá bán (₫)</label>
                    <input class="form-control" id="editGiaBan" type="number">

                    <label class="form-label mt-2">Giá vốn (₫)</label>
                    <input class="form-control" id="editGiaVon" type="number">

                    <label class="form-label mt-2">Tồn kho</label>
                    <input class="form-control" id="editTonKho" type="number">
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-xanhbo" onclick="submitEditPart()">Lưu thay đổi</button>
            </div>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ===========================================
    // 1. ĐỊNH NGHĨA HẰNG SỐ CHỈ SỐ CỘT (0-indexed)
    // ===========================================
    var table; // Biến table cần là global
    const CODE_COL = 0;
    const GROUP_COL = 2;
    const SELL_PRICE_COL = 3;
    const COST_PRICE_COL = 4;
    const STOCK_COL = 5;
    const CREATED_DATE_COL = 7;
    const ACTION_COL = 9;

    // ===========================================
    // 2. HÀM PHỤ TRỢ (Currency, Filter Logic, Date)
    // ===========================================
    function formatCurrency(number) {
        const num = parseInt(number) || 0;
        return new Intl.NumberFormat('vi-VN', {style:'currency', currency:'VND', minimumFractionDigits:0}).format(num).replace('₫', 'đ'); 
    }

    function formatDate(data) {
        if (!data) return '';
        const date = new Date(data);
        // Kiểm tra tính hợp lệ của ngày tháng
        if (isNaN(date.getTime())) return data; 
        // Định dạng: dd/mm/yyyy hh:mm
        return date.toLocaleDateString('vi-VN') + ' ' + date.toLocaleTimeString('vi-VN').substring(0,5); 
    }

    function applyGroupFilter(groupValue) {
        // Áp dụng filter bằng regex để lọc chính xác giá trị
        table.column(GROUP_COL).search(groupValue ? '^'+groupValue+'$' : '', true, false).draw();
    }

    function triggerCustomFilters() { 
        table.draw(); 
    }
    
    function openEditModal(maHang){
    $.ajax({
        url: '/HangHoa/GetById?ma=' + maHang, // API lấy dữ liệu chi tiết linh kiện
        type: 'GET',
        success: function(res){
            // Điền dữ liệu vào Modal
            $('#editMaHang').val(res.maHang);
            $('#editTenHang').val(res.tenHang);
            $('#editLoaiHang').val(res.loaiHang);
            $('#editGiaBan').val(res.giaBan);
            $('#editGiaVon').val(res.giaVon);
            $('#editTonKho').val(res.tonKho);
            
            // Hiển thị modal chỉnh sửa
            $('#editPartModal').modal('show');
        },
        error: function(xhr) { 
            console.error("Lỗi AJAX GetById:", xhr.responseText);
            alert('Lỗi Server khi tải dữ liệu linh kiện.'); 
        }
    });
}
function submitEditPart(){
    var data = {
        MaHang: $('#editMaHang').val(),
        TenHang: $('#editTenHang').val(),
        LoaiHang: $('#editLoaiHang').val(),
        GiaBan: parseInt($('#editGiaBan').val()) || 0,
        GiaVon: parseInt($('#editGiaVon').val()) || 0,
        TonKho: parseInt($('#editTonKho').val()) || 0
    };
    
    if(!data.TenHang){ alert('Vui lòng nhập Tên linh kiện.'); return; }

    $.ajax({
        url:'/HangHoa/EditAjax', // Dùng chung API chỉnh sửa với Hàng hóa
        type:'POST',
        contentType:'application/json',
        data:JSON.stringify(data),
        success:function(res){
            if(res.success){
                $('#editPartModal').modal('hide');
                // Tải lại DataTables để hiển thị thay đổi
                table.ajax.reload(null, false); 
                alert("Cập nhật linh kiện thành công!");
            } else alert("Cập nhật thất bại!");
        },
        error: function(xhr) { 
            console.error("Lỗi AJAX EditAjax:", xhr.responseText);
            alert('Lỗi Server khi cập nhật linh kiện.'); 
        }
    });
}

    function deleteProduct(maHang) {
    if (!confirm(`Bạn có chắc chắn muốn xóa linh kiện có Mã: ${maHang}? Thao tác này không thể hoàn tác.`)) {
        return; 
    }
    
    $.ajax({
        url: '/HangHoa/DeleteAjax', // Dùng chung API xóa với Hàng hóa
        type: 'POST', 
        contentType: 'application/json',
        data: JSON.stringify({ MaHang: maHang }), // Truyền Mã hàng (linh kiện) để xóa
        success: function(res) {
            if (res.success) {
                alert(`Đã xóa linh kiện [${maHang}] thành công khỏi hệ thống!`);
                
                // 2. Tải lại DataTables để xóa linh kiện khỏi giao diện
                table.ajax.reload(null, false); 
            } else {
                alert("Xóa linh kiện thất bại! Lỗi: " + (res.message || 'Không rõ.'));
            }
        },
        error: function(xhr) {
            console.error("Lỗi AJAX khi xóa:", xhr.responseText);
            alert('Có lỗi Server khi thực hiện xóa linh kiện.');
        }
    });
}
    function handleNewPartSubmit() {
        const name = $('#partName').val().trim();
        if (!name) { alert("Vui lòng nhập Tên linh kiện."); return; }

        // Lấy dữ liệu form
        const data = {
            MaHang: $('#partCode').val().trim(),
            TenHang: name,
            LoaiHang: $('#partGroup').val(),
            GiaBan: parseInt($('#sellPrice').val()) || 0,
            GiaVon: parseInt($('#costPrice').val()) || 0,
            TonKho: parseInt($('#initialStock').val()) || 0,
            KhachDat: 0, 
            DatNCC: 0 
        };
        
        // Gửi dữ liệu lên Server
        $.ajax({
            url: "/HangHoa/Create", 
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function(res) {
                if (res.success) {
                    alert(`Đã thêm linh kiện "${data.TenHang}" thành công! Mã: ${res.maHang}`);
                    
                    const modal = bootstrap.Modal.getInstance(document.getElementById('newPartModal'));
                    modal.hide();
                    $('#addPartForm')[0].reset();
                    
                    table.ajax.reload(null, false); 
                } else {
                    alert('Thêm linh kiện thất bại. Lỗi: ' + (res.message || 'Lỗi không xác định.'));
                }
            },
            error: function(xhr) {
                console.error("Lỗi AJAX:", xhr.responseText);
                alert('Lỗi kết nối Server khi thêm linh kiện.');
            }
        });
    }

    // ===========================================
    // 4. KHỞI TẠO DATATABLES
    // ===========================================
    $(document).ready(function() {
        table = $('#partsTable').DataTable({
            // 🛠️ Cấu hình AJAX để tải dữ liệu
            ajax:{
                url: "/HangHoa/GetAllLinhKien", // Gọi Action trong Controller
                dataSrc: ""
            },
            // 🛠️ Định nghĩa các cột
            columns:[
                { data:"maHang", className:"text-center" },     
                { data:"tenHang", className:"text-start" },    
                { data:"loaiHang", className:"text-center" },   
                { data:"giaBan", className:"text-end" },        
                { data:"giaVon", className:"text-end" },        
                { data:"tonKho", className:"text-center" },     
                { data:"khachDat", className:"text-center" },   
                { data:"thoiGianTao", className:"text-center" }, 
                { data:"datNCC", className:"text-center" },     
                // Cột Thao tác
                { data:"maHang", orderable:false, searchable:false, className:"text-center" }
            ],
            
            // Cấu hình DOM, Order, Language
            dom:'rtip',
            order:[[STOCK_COL,'desc']],
            language: {
                sProcessing: "Đang xử lý...",
                sLengthMenu: "Xem _MENU_ mục",
                sZeroRecords: "Không tìm thấy linh kiện nào phù hợp",
                sInfo: "Hiển thị _START_ đến _END_ trong tổng số _TOTAL_ mục",
                sInfoEmpty: "Hiển thị 0 đến 0 trong tổng số 0 mục",
                sInfoFiltered: "(được lọc từ tổng số _MAX_ mục)",
                sSearch: "Tìm kiếm:",
                oPaginate: { sFirst:"Đầu", sLast:"Cuối", sNext:"Tiếp", sPrevious:"Trước" }
            },
            columnDefs: [
                // Định dạng tiền tệ
                { targets:[SELL_PRICE_COL, COST_PRICE_COL], render:function(data,type){ const num=parseInt(data)||0; return (type==='display'||type==='filter')?formatCurrency(num):num; }, className:'text-end' },
                
                // Định dạng Nhóm linh kiện (Dùng badge xanh lá đậm đồng bộ)
                { 
                    targets:GROUP_COL, 
                    render:function(data,type){ 
                        if(type==='display') return `<span class="badge badge-linhkien-group">${data}</span>`; 
                        return data; 
                    }, 
                    className:'text-center' 
                },
                // Định dạng Tên hàng (Chỉ để cho chắc chắn)
                { targets:1, className:'text-start' },
                
                // Định dạng Thời gian tạo
                { 
                    targets:CREATED_DATE_COL,
                    render: function(data, type) {
                        return (type === 'display') ? formatDate(data) : data;
                    }
                },
                
                // Cột Thao tác (Đồng bộ với trang Hàng hóa)
                { 
                    targets:ACTION_COL, 
                    orderable:false, 
                    searchable:false, 
                    render: function(d){
                        return `
                            <div class="d-flex justify-content-center gap-2">
                                <a href="javascript:void(0)" onclick="openEditModal('${d}')" class="btn btn-sm btn-xanhbo" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></a>
                                <a href="javascript:void(0)" onclick="deleteProduct('${d}')" class="btn btn-sm btn-danger" title="Xóa linh kiện"><i class="fa-solid fa-trash"></i></a>
                            </div>
                        `;
                    }
                }
            ]
        });

        // Custom Filter tồn kho
        $.fn.dataTable.ext.search.push(function(settings,data){
            if(settings.nTable.id!=='partsTable') return true;
            const stockFilter = $('#quickFilterStock').val() || $('#filterStock').val();
            const stock = parseInt(data[STOCK_COL])||0;
            if(stockFilter==='available' && stock<=0) return false;
            if(stockFilter==='outOfStock' && stock>0) return false;
            return true;
        });

        // Sidebar Filter đồng bộ với Quick Filter
        $('#filterGroup').on('change', function(){ const val=$(this).val(); $('#quickFilterGroup').val(val); applyGroupFilter(val); });
        $('#filterStock').on('change', function(){ const val=$(this).val(); $('#quickFilterStock').val(val); triggerCustomFilters(); });

        // Quick Filter đồng bộ với Sidebar Filter
        $('#quickFilterGroup').on('change', function(){ const val=$(this).val(); $('#filterGroup').val(val); applyGroupFilter(val); });
        $('#quickFilterStock').on('change', function(){ const val=$(this).val(); $('#filterStock').val(val); triggerCustomFilters(); });

        // Global search
        $('#globalSearchBox').on('keyup', function(){ table.search(this.value).draw(); });
    });
</script>