    <script src="~/dist/js/adminlte.min.js"></script>
        <script>
    // Hàm điều chỉnh chung cho tất cả DataTables (nếu có)
    function adjustDataTables() {
        // Chỉ chạy nếu jQuery và DataTables đã tải
        if (typeof $ !== 'undefined' && $.fn.DataTable) {
            // Lặp qua tất cả các bảng đã được khởi tạo
            $.fn.dataTable.tables(true).forEach(function(table) {
                $(table).DataTable().columns.adjust().draw();
            });
        }
    }

    // 1. Điều chỉnh khi Sidebar mở/đóng
    $(document).on('expanded.lte.pushmenu collapsed.lte.pushmenu', function() {
        // Chờ 150ms để hiệu ứng trượt hoàn tất
        setTimeout(adjustDataTables, 150); 
    });
    
    // 2. Điều chỉnh khi cửa sổ trình duyệt thay đổi kích thước (Global fix)
    $(window).on('resize', function() {
        adjustDataTables();
    });
</script>

